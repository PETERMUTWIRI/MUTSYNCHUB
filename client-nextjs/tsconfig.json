{
  "compilerOptions": {
    "target": "es2020", // Updated from es5 for modern browser support
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler", // Updated from node for Next.js 15
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve", // Still valid for Next.js
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Add strictNullChecks if not already enabled (optional, but recommended)
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".next",
    "**/[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]-[a-f0-9]*"
  ]
}